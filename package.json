{
  "name": "vite-vue-ts-antd-starter",
  "type": "module",
  "version": "0.1.0",
  "author": "zhixiangyao <blueskyzx@icloud.com> <https://github.com/zhixiangyao>",
  "license": "MIT",
  "homepage": "https://github.com/zhixiangyao/vite-vue-ts-antd-starter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhixiangyao/vite-vue-ts-antd-starter.git"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=26.2.0",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm typecheck && vite build",
    "preview": "npm run build && vite preview",
    "preview:dist": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "lint:css": "stylelint \"./**/*.{vue,css}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint-staged": "lint-staged",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@vueuse/core": "14.3.0",
    "ant-design-vue": "4.2.6",
    "pinia": "3.0.4",
    "vue": "3.5.34",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/nprogress": "0.2.3",
    "@unocss/preset-rem-to-px": "66.7.0",
    "@unocss/reset": "66.7.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/compiler-sfc": "3.5.34",
    "@vue/tsconfig": "0.9.1",
    "lint-staged": "17.0.5",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "simple-git-hooks": "2.13.1",
    "stylelint": "17.12.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "unocss": "66.7.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.0.14",
    "vue-tsc": "3.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,jsx,ts,mts,tsx,vue}": [
      "pnpm lint:check"
    ],
    "**/*.{js,cjs,mjs,jsx,ts,mts,tsx,vue,html,md,json,css,yaml,yml}": [
      "pnpm fmt:check"
    ],
    "**/*.{vue,css}": [
      "stylelint --cache --cache-location node_modules/.cache/stylelint/"
    ]
  }
}
